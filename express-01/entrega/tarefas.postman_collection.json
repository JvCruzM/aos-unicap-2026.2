{
  "info": {
    "name": "AOS - API de Tarefas",
    "description": "CRUD de tarefas com UUID e Zod. Execute a pasta 01 em ordem. A criação salva automaticamente objectId para as próximas requisições. A variável baseUrl aponta para a API publicada na Vercel; use http://localhost:4001 para testar localmente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://aplicacoes-orientadas-a-servico-beta.vercel.app",
      "type": "string"
    },
    {
      "key": "objectId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Demonstração CRUD (executar em ordem)",
      "item": [
        {
          "name": "1. Criar tarefa (padrão concluida=false)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Gravar demonstração da API de tarefas\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/tarefas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const tarefa = pm.response.json();",
                  "pm.test('UUID v4 gerado pelo servidor', () => pm.expect(tarefa.objectId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i));",
                  "pm.test('Padrão concluida=false', () => pm.expect(tarefa.concluida).to.eql(false));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('objectId', tarefa.objectId);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Listar tarefas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tarefas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Retorna um array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('Inclui a tarefa criada', () => pm.expect(pm.response.json().some(t => t.objectId === pm.collectionVariables.get('objectId'))).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Buscar tarefa por UUID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tarefas/{{objectId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('ID corresponde ao cadastro', () => pm.expect(pm.response.json().objectId).to.eql(pm.collectionVariables.get('objectId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Atualizar tarefa",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Demonstração concluída\",\n  \"concluida\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/tarefas/{{objectId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tarefa atualizada', () => { pm.expect(pm.response.json().descricao).to.eql('Demonstração concluída'); pm.expect(pm.response.json().concluida).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Excluir tarefa",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/tarefas/{{objectId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Mensagem de sucesso', () => pm.expect(pm.response.json().message).to.eql('Tarefa excluída com sucesso.'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Validações e erros",
      "item": [
        {
          "name": "Sem descricao: 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/tarefas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Descricao vazia: 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"   \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/tarefas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Concluida deve ser booleano: 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Teste inválido\",\n  \"concluida\": \"true\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/tarefas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "UUID inválido: 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tarefas/id-invalido"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar tarefa excluída: 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tarefas/{{objectId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar tarefa inexistente: 404",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"concluida\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/tarefas/00000000-0000-4000-8000-000000000001"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Excluir tarefa inexistente: 404",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/tarefas/00000000-0000-4000-8000-000000000001"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
